# colors are generated by matugen; `?` makes the include optional
config-file = ?colors.ghostty

# --- Font ---
# monospace on purpose, Ghostty ships its own Nerd Font symbols
font-family = Noto Sans Mono
font-size   = 12

# --- Window ---
# size is in cells, not pixels
window-width           = 100
window-height          = 26
window-padding-x       = 10
window-padding-y       = 10
window-padding-balance = true
window-padding-color   = extend
window-decoration      = none
gtk-titlebar           = false
background-opacity     = 0.99
resize-overlay         = never
confirm-close-surface  = false

# --- Cursor ---
cursor-style       = block
cursor-style-blink = true

# --- Scrolling / mouse ---
# in bytes, not lines
scrollback-limit        = 10000000
mouse-scroll-multiplier = 1
mouse-hide-while-typing = true

# --- Clipboard ---
copy-on-select             = clipboard
clipboard-paste-protection = true
app-notifications          = no-clipboard-copy

# --- Bell ---
bell-features = no-audio,no-system

# --- Shell integration ---
# ssh-env/ssh-terminfo replace kitty's ssh kitten
shell-integration          = zsh
shell-integration-features = no-cursor,sudo,title,ssh-env,ssh-terminfo

# --- Performance ---
# io_uring can be sluggish on Hyprland
async-backend = epoll

# --- Keybinds ---
# lets TUIs tell shift+enter apart from enter
keybind = shift+enter=text:\x1b[13;2u
